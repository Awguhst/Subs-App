# Copy to .env for local runs. On Railway, set these as service variables instead.

# Required: ElevenLabs secret key with Speech-to-Text access (starts with sk_).
ELEVENLABS_API_KEY=
# Needed for English subtitles. Without it only Bulgarian is returned.
ANTHROPIC_API_KEY=
# Client keys for this API, comma-separated. Strongly recommended on any public URL:
# without them, anyone who finds the URL can spend your ElevenLabs/Anthropic credit.
API_KEYS=

# --- Optional (defaults shown) ---
# MAX_UPLOAD_MB=2048
# MAX_DURATION_MINUTES=240
# MAX_CONCURRENT_JOBS=2
# TRANSLATION_CONCURRENCY=6
# Lifetime translation cap in USD; can be lowered, never raised above 20.
# TRANSLATION_BUDGET_USD=20
# Results of identical uploads are reused for this long; 0 disables caching.
# CACHE_TTL_HOURS=168
# ELEVENLABS_TIMEOUT_SECONDS=1800
# ANTHROPIC_TIMEOUT_SECONDS=120
# CORS_ORIGINS=*
# ENABLE_WEB_UI=true
# DATA_DIR=./data
# LOG_LEVEL=info
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
